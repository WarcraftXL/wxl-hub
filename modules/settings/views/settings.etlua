<div class="page">
  <section class="first">
    <%- render("core:crumbs", { trail = trail }) %>
    <% --[[ The same band the other working pages open with. It was the one page that opened on a bare
            heading, which made it read as somewhere you had fallen out of the app rather than as one
            more place in it. ]] %>
    <%- render("core:pagehead", {
          title = "Settings",
          lead  = "Everything the hub remembers, kept in hub.db on this machine.",
          image = pageimage("settings"),
        }) %>

    <%- render("prefs", { sections = sections, active = active, body = body }) %>
  </section>
</div>
