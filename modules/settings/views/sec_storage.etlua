<div class="set panel">
  <h3>Catalogue cache</h3>
  <p class="hint">The store index and its images are kept locally so the hub still opens without a
    connection.</p>
  <div class="field">
    <label>Lifetime</label>
    <div class="val"><span class="note"><%= cache.ttl %></span></div>
  </div>
  <div class="field">
    <label>On disk</label>
    <div class="val">
      <span class="note"><%= cache.size %> across <%= cache.entries %> entries</span>
      <a class="browse" hx-post="/settings/cache/clear" hx-target="next .ok"
         hx-swap="outerHTML">Clear cache</a>
      <span class="ok"></span>
    </div>
  </div>
  <div class="field">
    <label>Last refresh</label>
    <div class="val">
      <span class="note"><%= cache.age %></span>
      <% if cache.entries > 1 and cache.stalest then %>
        <span class="note">&middot; oldest entry <%= cache.stalest %></span>
      <% end %>
    </div>
  </div>
  <div class="field">
    <label>Past its lifetime</label>
    <div class="val">
      <% if cache.expired == 0 then %>
        <span class="ok"><%- icon("check") %></span><span class="note">nothing, everything here is current</span>
      <% else %>
        <span class="warn"><%= cache.expired %></span>
        <span class="note">of <%= cache.entries %>, kept so the hub still opens without a network</span>
      <% end %>
    </div>
  </div>
</div>

<div class="set panel">
  <h3>Database</h3>
  <p class="hint">Applied migrations, newest first. Files are append-only: editing one that has
    already run cannot change a database that already ran it.</p>
  <% for _, u in ipairs(updates) do %>
    <div class="field">
      <label><%= u.path:match("([^/]+)$") %></label>
      <div class="val">
        <span class="note"><%= u.path %></span>
        <span class="pill"><%= u.ms %> ms</span>
      </div>
    </div>
  <% end %>
</div>
