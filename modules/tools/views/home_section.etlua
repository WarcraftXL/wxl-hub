<section>
  <div class="sec">
    <h2>Developer tools</h2>
    <span class="spacer"></span>
    <span class="aside"><a href="/tools">All tools →</a></span>
  </div>
  <div class="tools">
    <% for _, t in ipairs(tools) do %>
      <a class="tool panel" href="/tools/<%= t.id %>">
        <span class="ico"><%= t.icon %></span>
        <span class="t"><b><%= t.name %></b><span><%= t.blurb %></span></span>
      </a>
    <% end %>
  </div>
</section>
