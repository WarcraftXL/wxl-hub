<div class="page">
  <section class="first">
    <%- render("core:crumbs", { trail = trail }) %>
    <%- render("core:pagehead", {
          title = "Developer tools",
          lead  = "Each one drives a program in tools/ and reports back here. Nothing runs until "
               .. "you start it.",
          image = pageimage("tools"),
        }) %>

    <% if not available then %>
      <div class="panel" style="padding:1.2rem 1.4rem;margin-bottom:1.2rem">
        <p style="margin:0;color:var(--gold)">
          Unavailable: <%= table.concat(missing, ", ") %> not found on this machine.
          The pages open, but nothing will run.
        </p>
      </div>
    <% end %>

    <div class="tools">
      <% for _, t in ipairs(tools) do %>
        <a class="tool panel" href="/tools/<%= t.id %>">
          <span class="ico"><%= t.icon %></span>
          <span class="t"><b><%= t.name %></b><span><%= t.blurb %></span></span>
          <span class="pill <%= t.status %>"><%= t.status %></span>
        </a>
      <% end %>
    </div>
  </section>
</div>
