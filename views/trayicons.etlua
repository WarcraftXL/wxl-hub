<% --[[ A native <details> rather than a scripted dropdown: it opens, closes and answers the keyboard
        on its own, and the panel only fetches when it is actually opened.

        The counters live in their own slots (see traypip) so they can be refreshed without touching
        this element. Replacing the tray would replace the <details>, and replacing an open <details>
        closes it. ]] %>
<span class="tray" id="tray">

  <details class="bell">
    <summary title="Notifications">
      <%- icon("bell") %>
      <%- render("core:traypip", { id = "bellpip", n = unread }) %>
    </summary>
    <div class="traypanel" hx-get="/notifications/panel"
         hx-trigger="toggle from:closest details" hx-swap="innerHTML">
      <span class="note">opening</span>
    </div>
  </details>

  <a class="dl <%= active == 'downloads' and 'on' or '' %>" href="/downloads" title="Downloads">
    <%- icon("download") %>
    <%- render("core:traypip", { id = "dlpip", n = queued }) %>
  </a>

</span>
