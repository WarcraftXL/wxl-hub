<a class="card panel" href="/store/<%= mod.id %>" style="<%= accent(mod.id) %>">
  <span class="head">
    <span class="mark" style="<%= markstyle(mod.id) %>"><%= initial(mod.id) %></span>
    <h3><%= mod.id %></h3>
    <% if mod.official then %><span class="official">Official</span><% end %>
  </span>
  <span class="by">by <%= mod.owner %></span>
  <span class="desc"><%= mod.tagline %></span>
  <span class="cats">
    <% for _, c in ipairs(mod.categories or {}) do %><span><%= c %></span><% end %>
  </span>
  <span class="foot">
    <span>&#9733; <%= mod.stars %></span>
    <span><%= since(mod.updated) %></span>
    <% --[[ A card never installs. It says what the listing will offer, and the listing is where the
            reason lives when the answer is no. ]] %>
    <span class="get"><%= mod.installable and "Install" or "Details" %></span>
  </span>
</a>
