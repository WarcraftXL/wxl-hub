<!doctype html>
<meta charset="utf-8">
<title><%= title %></title>
<meta http-equiv="Content-Security-Policy" content="<%= csp %>">
<link rel="icon" href="/static/logo.png">
<script src="/vendor/htmx.min.js"></script>

<%- render("pickfolder", {}) %>
<link rel="stylesheet" href="<%= stylesheet %>">

<% --[[ The shell is built once and stays. Every link inside it fetches the page it points at and
        replaces only `#view`, so the bar, the tray and the status bar are never rebuilt: they keep
        their state, their blur surface, and they do not replay their entrance on each click. That is
        the whole difference between a window showing pages and a window that has pages in it.

        The server answers such a request with the fragment rather than the document; see
        views/layout_view.etlua. Typing the same URL by hand still gets a whole page, because what
        decides is the header htmx sends, not the address.

        Where the fragment lands is decided by that same answer, through HX-Retarget. It cannot be an
        `hx-target` here: an element's target is inherited by every htmx element beneath it, and the
        ones that mean "swap me" do not say so, they simply leave it out. The notification panel, a
        job's progress element and every self-replacing fragment in the app would have been aimed at
        the page body. ]] %>
<body hx-boost="true">

<header class="top">
  <a class="brand" href="/">
    <img src="/static/logo.png" alt="">
    <span>Warcraft<em>XL</em></span>
  </a>
  <%- render("nav", { nav = nav }) %>
  <span class="spacer"></span>

  <% --[[ The bell polls for its own count; the downloads pip is rendered with the page and refreshed
          by the same poll, so one request keeps both honest. ]] %>
  <%- render("core:trayicons", { unread = unread, queued = queued, active = active }) %>

  <a class="profile <%= active == 'settings' and 'on' or '' %>" href="/settings">
    <span class="dot"></span><span id="profilename"><%= profile %></span>
  </a>
  <% --[[ Swaps nothing: the only thing that comes back is a toast, which lands out of band. ]] %>
  <button class="play" hx-post="/launch" hx-swap="none">Play</button>
</header>

<% if stale then %>
<div class="stalebar">
  <%- icon("triangle-alert") %>
  <span><%= stale.text %></span>
</div>
<% end %>

<% --[[ Toasts are appended here out of band by whatever response raised them. Part of the layout, so
        navigating away is also what clears the ones that have already faded.

        It starts empty except for anything raised before there was a page to raise it on, which is
        what core.page's queue holds. ]] %>
<div id="toasts" aria-live="polite"><%- toasts or "" %></div>

<% --[[ The one part of the document that changes between pages, and therefore the only part a
        navigation replaces. ]] %>
<div id="view"><%- body %></div>

<%- render("shellscript", {}) %>

<% if discord then %>
<% --[[ Left alone by the boosting above: it leaves for a browser, and there is no `#view` at the
        other end of it. ]] %>
<a class="fab" href="<%= discord %>" target="_blank" rel="noopener noreferrer" hx-boost="false">
  <%- icon("message-circle") %>
  Join the Discord
</a>
<% end %>

<footer>
  <span class="figs">
    <span><b><%= stats.modules %></b> module<%= tonumber(stats.modules) == 1 and "" or "s" %></span>
    <span><b><%= stats.authors %></b> author<%= tonumber(stats.authors) == 1 and "" or "s" %></span>
    <span>catalogue <b><%= cache_age %></b></span>
  </span>
  <span class="note">Read from GitHub. A repository is listed once it publishes a wxl.json.</span>
</footer>
