<% --[[ Polls itself: every response is a whole new element carrying the next poll, so a job that has
        finished simply returns markup without one and the polling stops on its own. There is no
        timer to cancel and no state on the page to get out of step. ]] %>
<div class="job <%= job.state %>"<% if job.state == "running" then %>
     hx-get="/jobs/<%= job.id %>" hx-trigger="load delay:400ms" hx-swap="outerHTML"<% end %>>

  <% if job.state == "running" then %>
    <% --[[ Without a Content-Length there is no honest percentage, so the bar sweeps instead of
            pretending to know. ]] %>
    <div class="bar<%= job.percent and "" or " idle" %>">
      <i style="width:<%= job.percent or 100 %>%"></i>
    </div>
    <span class="phase">
      <%= job.phase %><% if job.bytes then %> <b><%= job.bytes %></b><% end %>
    </span>

  <% elseif job.state == "done" then %>
    <% if job.kind == "install" then %>
      <% --[[ The button that started this sits outside the fragment being swapped, so it would go on
              saying Install over a finished install. Swapped out of band instead, which costs one
              element and no page reload. Absent from the DOM on other pages, and htmx is content to
              find no target. ]] %>
      <div class="install is-on" id="installbtn" hx-swap-oob="true">Installed</div>
      <span class="ok"><%- icon("check") %>installed</span>
      <a class="browse" href="/library">Library</a>
    <% elseif job.kind == "update" then %>
      <span class="ok"><%- icon("check") %>ready</span>
      <span class="phase">restart the hub to use it</span>
    <% else %>
      <span class="ok"><%- icon("check") %>done</span>
    <% end %>

    <% if job.after then %>
      <% --[[ Whatever the page said about the world was written before any of this was true, so the
              job asks for it again the moment it lands. Where to ask comes from whoever started the
              job: this partial is core's and is on three pages, and it used to name one module's
              URL, which meant the other two silently refreshed nothing. ]] %>
      <span hx-get="<%= job.after.url %>" hx-target="<%= job.after.target %>" hx-swap="outerHTML"
            hx-trigger="load delay:200ms"></span>
    <% end %>

  <% else %>
    <span class="bad"><%- icon("x") %></span>
    <span class="phase"><%= job.error or "it did not work" %></span>
  <% end %>
</div>
