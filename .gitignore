# Vendored binaries. Fetched and pinned by scripts/Get-Deps.ps1, not committed.
deps/luvi/
deps/webview/
deps/sqlite/

# Local state. hub.db holds this machine's profiles and client paths, `window` the size and position
# it was left at. A run from the repository writes both beside the sources, because there is no
# install folder to put them in.
*.db
*.db-wal
*.db-shm
*.log
/window

# Build output
build/

# Design notes. Kept on disk, not published: they describe how the app was planned rather than how
# it works, and they have drifted from it. Drop this line to put them back.
docs/

# Scratch
_t/
_probe*/
_probe*.db*
